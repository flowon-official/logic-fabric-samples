{
  "LogicApi": {
    "Project": "Case Management",
    "Api": "Customer Portal API",
    "Version": "latest",
    "MetadataWatchIntervalMinutes": 5
  },
  "Authentication": {
    "Authority": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "Audience": "<customer-portal-api-client-id>"
  },
  "Customers": {
    "CacheMinutes": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
